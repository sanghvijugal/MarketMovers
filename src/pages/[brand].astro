---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import LineSection from "@/components/brand/LineSection.astro";
import { buttonVariants } from "@/components/ui/button-variants";
import { brandPages, type Brand } from "@/data/brands";
import { brands, business, whatsappUrl, SITE_URL } from "@/data/site";
import { brandSchema } from "@/lib/schema";
import { ArrowRight01Icon, Call02Icon, WhatsappIcon } from "@hugeicons/core-free-icons";

export function getStaticPaths() {
  return brandPages.map((brand) => ({ params: { brand: brand.slug }, props: { brand } }));
}

const { brand } = Astro.props as { brand: Brand };
const path = `/${brand.slug}.html`;
const others = brands.filter((b) => b.slug && b.slug !== brand.slug);
const phone = business.phones[0];
---
<Base title={brand.seo.title} description={brand.seo.description} path={path} jsonLd={brandSchema(brand, SITE_URL + path)}>
  <div class="mx-auto max-w-[88rem] px-5 pt-6 pb-16 sm:px-8 md:pb-24 lg:px-14">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1.5 text-[17px] sm:text-[13px] text-muted-foreground">
        <li><a href="/" class="hover:text-foreground">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/#brands" class="hover:text-foreground">Brands</a></li>
        <li aria-hidden="true">/</li>
        <li><span aria-current="page" class="text-foreground">{brand.name}</span></li>
      </ol>
    </nav>
    <h1 class="mt-10 text-[clamp(4rem,13vw,11.5rem)] leading-[0.85] font-semibold tracking-[-0.06em]">
      {brand.name}<span class="block text-[0.42em] leading-[1.05] tracking-[-0.045em] text-faint">{brand.tagline}</span>
    </h1>
    <div class="mt-12 flex flex-col gap-8 border-t border-border pt-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="text-lg leading-snug">{brand.origin}</p>
        <p class="mt-2 text-muted-foreground">
          {[`${brand.lines.length} product lines`, ...brand.badges.filter((b) => !/product lines|available at/i.test(b))].join(" · ")}
        </p>
      </div>
      <div class="flex shrink-0 flex-wrap items-center gap-6">
        <a href={whatsappUrl(`Hello Market Movers, I'd like ${brand.name} prices and availability.`)} target="_blank" rel="noopener" class={buttonVariants({ size: "lg" })}>
          <Icon icon={WhatsappIcon} /><span class="roll"><span>Ask for {brand.name} rates</span></span>
        </a>
        <a href={`tel:${phone.tel}`} class="sweep font-medium tabular-nums">Call {phone.display}</a>
      </div>
    </div>
  </div>

  <div class="rule-top mx-auto max-w-[88rem] px-5 sm:px-8 lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-16 lg:px-14">
    <!-- Product line navigation: sticky sidebar on desktop, sticky scroller on mobile -->
    <nav aria-label={`${brand.name} product lines`} class="sticky top-[68px] z-30 -mx-4 border-b bg-background sm:-mx-6 lg:top-[76px] lg:mx-0 lg:self-start lg:border-b-0 lg:bg-transparent lg:pt-12">
      <p class="hidden px-3 text-[17px] sm:text-[13px] text-muted-foreground lg:block">Product lines</p>
      <ul id="line-nav" class="scroll-fade-x flex gap-1 overflow-x-auto overscroll-x-contain lg:[mask-image:none] px-4 py-2.5 [scrollbar-width:none] sm:px-6 lg:mt-3 lg:flex-col lg:gap-0.5 lg:overflow-visible lg:p-0">
        {brand.lines.map((l) => (
          <li class="shrink-0">
            <a href={`#${l.id}`} class="block border-b-2 border-transparent px-2 py-2 text-[19px] sm:text-[15px] whitespace-nowrap text-muted-foreground transition-colors duration-150 hover:text-foreground aria-[current=location]:border-primary aria-[current=location]:font-semibold aria-[current=location]:text-foreground lg:border-b-0 lg:border-l-2 lg:px-3 lg:whitespace-normal">{l.name}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="py-10 lg:py-12">
      {brand.lines.map((line, i) => <LineSection brand={brand} line={line} priority={i === 0} />)}
    </div>
  </div>

  <section class="rule-top mx-auto max-w-[88rem]" aria-labelledby="more-brands">
    <div class="mx-auto max-w-[88rem] px-5 py-20 sm:px-8 lg:px-14">
      <h2 id="more-brands" class="text-[17px] sm:text-[13px] font-normal text-muted-foreground">Other brands at Market Movers</h2>
      <p class="mt-6 text-[clamp(2.25rem,5.5vw,4.5rem)] leading-[1] font-semibold tracking-[-0.05em]">
        {others.map((b, i) => (
          <>
            <a href={`/${b.slug}.html`} class="transition-colors duration-200 hover:text-teal">{b.name}</a>{i < others.length - 1 ? ", " : "."}{" "}
          </>
        ))}
      </p>
      <a href="/#products" class="sweep mt-8 inline-block font-medium text-teal">All products</a>
    </div>
  </section>
</Base>

<script>
  // Accordions (transitions.dev "Accordion expand" + hidden="until-found").
  const CLOSE_MS = 220;
  function setOpen(acc: HTMLElement, open: boolean) {
    const head = acc.querySelector<HTMLElement>(":scope > * > .t-acc-head")!;
    const inner = acc.querySelector<HTMLElement>(":scope > .t-acc-panel > .t-acc-panel-inner")!;
    head.setAttribute("aria-expanded", String(open));
    if (open) {
      inner.removeAttribute("hidden");
      void inner.offsetHeight; // start the height transition from 0
      acc.dataset.open = "true";
    } else {
      acc.dataset.open = "false";
      window.setTimeout(() => {
        if (acc.dataset.open === "false") inner.setAttribute("hidden", "until-found");
      }, CLOSE_MS);
    }
  }
  document.addEventListener("click", (e) => {
    const head = (e.target as HTMLElement).closest(".t-acc-head");
    if (!head) return;
    const acc = head.closest<HTMLElement>(".t-acc")!;
    setOpen(acc, acc.dataset.open !== "true");
  });
  document.querySelectorAll<HTMLElement>(".t-acc-panel-inner").forEach((inner) => {
    inner.addEventListener("beforematch", () => setOpen(inner.closest<HTMLElement>(".t-acc")!, true));
  });

  // Highlight the product line currently in view.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>("#line-nav a").forEach((a) => links.set(a.hash.slice(1), a));
  const nav = document.getElementById("line-nav")!;
  // Fade whichever edge of the mobile scroller has more chips behind it.
  function updateFade() {
    const left = nav.scrollLeft > 4;
    const right = nav.scrollLeft + nav.clientWidth < nav.scrollWidth - 4;
    nav.style.setProperty("--fade-l", left ? "24px" : "0px");
    nav.style.setProperty("--fade-r", right ? "24px" : "0px");
  }
  nav.addEventListener("scroll", updateFade, { passive: true });
  addEventListener("resize", updateFade);
  updateFade();
  let current: HTMLAnchorElement | undefined;
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const link = links.get(entry.target.id);
        if (!link || link === current) continue;
        current?.removeAttribute("aria-current");
        link.setAttribute("aria-current", "location");
        current = link;
        // keep the active chip visible in the mobile scroller
        if (nav.scrollWidth > nav.clientWidth) {
          nav.scrollTo({ left: link.offsetLeft - 16, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
        }
      }
    },
    { rootMargin: "-30% 0px -60% 0px" },
  );
  document.querySelectorAll("main section[id]").forEach((s) => observer.observe(s));
</script>
