---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import EnquiryForm from "@/components/EnquiryForm";
import SizeRings from "@/components/home/SizeRings";
import Stats from "@/components/home/Stats";
import StockIndex from "@/components/home/StockIndex";
import LogoMark from "@/components/LogoMark.astro";
import GlassFrame from "@/components/GlassFrame.astro";
import pipeStack from "@/assets/photos/pipe-stack.jpg";
import pipeStackBlur from "@/assets/photos/pipe-stack-blur.jpg";
import hdpeCoil from "@/assets/photos/hdpe-coil.jpg";
import hdpeCoilBlur from "@/assets/photos/hdpe-coil-blur.jpg";
import counter from "@/assets/photos/counter.jpg";
import counterBlur from "@/assets/photos/counter-blur.jpg";
import fittings from "@/assets/photos/fittings.jpg";
import fittingsBlur from "@/assets/photos/fittings-blur.jpg";
import { buttonVariants } from "@/components/ui/button-variants";
import { business, brands, categories, whatsappUrl } from "@/data/site";
import { brandPages } from "@/data/brands";
import { homeSchema } from "@/lib/schema";
import { ArrowRight01Icon, WhatsappIcon } from "@hugeicons/core-free-icons";

const phone = business.phones[0];
const a = business.address;

const brandInfo: Record<string, { from: string; stock: string }> = {
  finolex: { from: "Pune", stock: "Agriculture, casing, column, CPVC, ASTM, SWR and sewerage pipes, solvent cement" },
  dutron: { from: "Ahmedabad", stock: "CPVC, uPVC, agriculture, SWR, casing and HDPE pipes, suction and garden hose" },
  texmo: { from: "Burhanpur, MP", stock: "CPVC to HDPE coils, drip and sprinkler systems, gas pipes, water tanks" },
  waterflo: { from: "Rajkot", stock: "CPVC, uPVC, push-fit SWR, agriculture and borewell pipes, HDPE" },
  johnson: { from: "Baddi and Samba", stock: "Taps, sanitaryware, showers, kitchen sinks, bathtubs, bathroom accessories" },
};
const sentence = brands.map((b) =>
  b.slug
    ? { name: b.name, slug: b.slug, lines: brandPages.find((p) => p.slug === b.slug)!.lines.length, ...brandInfo[b.slug] }
    : { name: b.name },
);
const totalLines = sentence.reduce((n, b) => n + ("lines" in b ? b.lines : 0), 0);

const stats = [
  { value: 1500, suffix: "+", label: "products in stock at the godown" },
  { value: brands.length, label: "brands on our shelves" },
  { value: totalLines, label: "product lines with full specifications online" },
  { value: categories.length, label: "product families, house plumbing to 400 mm mains" },
];

const steps = [
  { title: "Send your list", text: "On WhatsApp. Sizes and quantities are enough, and a photo of a handwritten list is fine." },
  { title: "Get rates the same day", text: "We reply with prices and tell you what's in stock at the godown." },
  { title: "Pick up or we deliver", text: "Collect from the shop in Marhatal, or we send it across Jabalpur and nearby districts." },
];

// Photos: generated product still lifes (no shop, stock or people claimed as ours),
// each behind glass panels (GlassFrame).
const wideSizes = "(min-width: 1408px) 1296px, (min-width: 1024px) calc(100vw - 7rem), (min-width: 640px) calc(100vw - 4rem), calc(100vw - 1.5rem)";

const wrap = "mx-auto max-w-[88rem] px-5 sm:px-8 lg:px-14";
// photo frames run a little wider than the text on phones
const frameWrap = "mx-auto max-w-[88rem] px-3 sm:px-8 lg:px-14";
const pad = "py-16 md:py-24";
const label = "text-[17px] sm:text-[13px] text-muted-foreground";
const h2 = "text-[clamp(2.25rem,4.6vw,4.25rem)] leading-[0.98] font-semibold tracking-[-0.045em]";
const link = "sweep inline-flex items-center gap-1.5 font-medium";
---
<Base
  title="Pipes & Sanitary Distributor in Jabalpur, MP | Market Movers"
  description="Market Movers, Jabalpur: distributor of Finolex, Dutron, Texmo, Waterflo & Johnson. PVC, CPVC, HDPE pipes, sprinklers & sanitaryware across Madhya Pradesh."
  path="/"
  jsonLd={homeSchema()}>

  <!-- Logo and name, full width; shrinks into the header logo on scroll (global.css) -->
  <div class="wordmark-top pt-4" aria-hidden="true">
    <div class="flex items-center justify-center gap-[0.14em] px-3 text-[12.4vw] leading-[0.8] font-semibold tracking-[-0.06em] whitespace-nowrap sm:text-[clamp(3rem,13vw,13rem)]">
      <LogoMark id="mm-top" animate class="h-[0.78em] w-auto shrink-0" weight={18} />
      <span>Market Movers</span>
    </div>
  </div>

  <!-- Hero: the pipe photo with the headline and the size rings on glass over it.
       The name above is the one giant line; the headline sits a clear step below it. -->
  <div class:list={[frameWrap, "pt-6 md:pt-10"]}>
    <GlassFrame src={pipeStack} blur={pipeStackBlur} loading="eager" sizes={wideSizes} pos="0% 50%"
      alt="A pyramid of white, cream, grey and black plastic pipes stacked on a concrete floor"
      class="grid gap-3 p-3 pt-[44vw] sm:gap-6 sm:p-6 sm:pt-40 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] lg:items-end lg:gap-8 lg:p-10 lg:pt-56">
      <section class="glass flex flex-col p-6 sm:p-10">
        <p class={label}>Wholesale distributor in Marhatal, Jabalpur</p>
        <h1 class="mt-4 max-w-3xl text-[2.25rem] leading-[1] font-medium tracking-[-0.045em] text-balance sm:text-[clamp(2.75rem,4.8vw,4.5rem)]">
          Pipes, fittings and sanitaryware<span class="text-muted-foreground">, from stock.</span>
        </h1>
        <p class="mt-6 max-w-lg text-[clamp(1.25rem,1.6vw,1.35rem)] leading-snug tracking-[-0.01em]">
          Ten brands in stock at our Marhatal counter. Send your list on WhatsApp and get rates the same day.
        </p>
        <div class="mt-8 flex items-center gap-6">
          <a href={whatsappUrl("Hello Market Movers, here is my list:")} target="_blank" rel="noopener" class={buttonVariants({ size: "lg" })}>
            <Icon icon={WhatsappIcon} /><span class="roll"><span>WhatsApp your list</span></span>
          </a>
          <a href={`tel:${phone.tel}`} class="sweep hidden items-center gap-1.5 font-medium whitespace-nowrap tabular-nums sm:inline-flex">Call {phone.display}</a>
        </div>
      </section>
      <div class="glass p-5 sm:p-7">
        <div class="mx-auto max-w-[17rem] sm:max-w-none">
          <SizeRings client:load />
        </div>
      </div>
    </GlassFrame>
  </div>

  <!-- Figures, on glass over the HDPE coil -->
  <div class:list={[frameWrap, "pt-16 md:pt-24"]}>
    <GlassFrame src={hdpeCoil} blur={hdpeCoilBlur} sizes={wideSizes} pos="35% 50%"
      alt="A coil of black HDPE pipe with one cut end in front"
      class="grid gap-3 p-3 pt-[40vw] sm:gap-6 sm:p-6 sm:pt-32 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] lg:items-end lg:p-10 lg:pt-48">
      <section class="glass p-6 sm:p-10">
        <h2 class:list={[h2, "max-w-xl"]}>Ready stock, so your site never waits on a factory.</h2>
      </section>
      <div class="glass p-6 sm:p-10">
        <Stats client:visible stats={stats} />
      </div>
    </GlassFrame>
  </div>

  <!-- Brands and products as one index: brands lead, product chips are the other way in -->
  <section id="brands" class:list={[wrap, pad]}>
    <h2 class={h2} data-reveal>Brands we stock</h2>
    <p lang="hi" class="mt-3 font-hindi text-lg text-muted-foreground">हमारे ब्रांड</p>
    <div class="mt-12 md:mt-16">
      <StockIndex
        client:visible
        brands={sentence}
        categories={categories.map((c) => ({ id: c.id, name: c.name, text: c.text, brands: [...c.brands] }))}
        whatsapp={business.whatsapp}
        askHref={whatsappUrl("Hello Market Movers, do you have ")}
      />
    </div>
  </section>

  <!-- Ordering: the steps on glass over the counter photo -->
  <div id="order" class={frameWrap}>
    <GlassFrame src={counter} blur={counterBlur} sizes={wideSizes} pos="70% 50%"
      alt="Hands writing an order list at a wooden counter, beside white PVC fittings and a phone"
      class="p-3 pt-[40vw] sm:p-6 sm:pt-32 lg:p-10 lg:pr-[34%]">
      <section class="glass p-6 sm:p-10 lg:p-12">
        <h2 class:list={[h2, "read-words max-w-4xl"]}>
          {"Send the list. We'll handle the rest.".split(" ").map((w) => <span>{w} </span>)}
        </h2>
        <p lang="hi" class="mt-3 font-hindi text-lg text-muted-foreground">ऑर्डर कैसे करें</p>
        <ol class="mt-8 md:mt-12">
          {steps.map((st) => (
            <li class="grid gap-y-2 border-t border-foreground/15 py-6 md:py-7">
              <h3 class="text-[clamp(1.75rem,3.4vw,3rem)] leading-[1] font-semibold tracking-[-0.05em]">{st.title}</h3>
              <p class="max-w-[48ch] text-[19px] sm:text-[17px] leading-relaxed text-muted-foreground">{st.text}</p>
            </li>
          ))}
        </ol>
        <a href={whatsappUrl("Hello Market Movers, here is my list:")} target="_blank" rel="noopener" class={buttonVariants({ size: "lg", class: "mt-6" })}>
          <Icon icon={WhatsappIcon} /><span class="roll"><span>WhatsApp your list</span></span>
        </a>
      </section>
    </GlassFrame>
  </div>

  <!-- Visit and enquiry side by side on desktop: the address and map on the left,
       the form on glass over the fittings photo on the right -->
  <div class:list={[wrap, pad, "grid gap-16 lg:grid-cols-2 lg:gap-10"]}>
    <section id="contact" class="flex flex-col">
      <h2 class="text-[clamp(2.25rem,4vw,3.75rem)] leading-[0.98] font-semibold tracking-[-0.045em]" data-reveal>
        {a.street}, {a.city}.
      </h2>
      <p lang="hi" class="mt-3 font-hindi text-lg text-muted-foreground">दुकान पर आइए</p>
      <div class="mt-8 space-y-2 text-lg">
        <p>{business.hours.days}, {business.hours.display}. <span class="text-muted-foreground">Sunday closed.</span></p>
        <p class="tabular-nums">
          {business.phones.map((p, i) => (
            <>{i > 0 && <span class="text-muted-foreground">, </span>}<a href={`tel:${p.tel}`} class="hover:text-teal">{p.display}</a></>
          ))}
        </p>
      </div>
      <div class="mt-5 flex flex-wrap gap-x-8 gap-y-3 text-lg">
        <a href={business.mapUrl} target="_blank" rel="noopener" class:list={[link, "text-teal"]}>Directions in Google Maps<Icon icon={ArrowRight01Icon} size={16} class="sweep-arrow" /></a>
        <a href={whatsappUrl()} target="_blank" rel="noopener" class:list={[link, "text-teal"]}>WhatsApp {phone.display}<Icon icon={ArrowRight01Icon} size={16} class="sweep-arrow" /></a>
      </div>
      <div class="mt-8 flex-1 overflow-hidden border border-border bg-muted" style="border-radius: var(--radius-glass)">
        <iframe
          src={business.mapEmbedUrl}
          title="Map showing Market Movers in Anjuman Market, Marhatal, Jabalpur"
          class="block aspect-[4/3] h-full min-h-[18rem] w-full"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <p class="mt-3 text-[17px] sm:text-[13px] text-muted-foreground">We deliver across Jabalpur and to nearby districts.</p>
    </section>

    <GlassFrame src={fittings} blur={fittingsBlur} pos="0% 50%"
      sizes="(min-width: 1024px) 50vw, calc(100vw - 2.5rem)"
      alt="White uPVC, cream CPVC and grey PVC fittings with brass ball valves and a tin of solvent cement, laid out on a grey surface"
      class="-mx-2 p-2 sm:mx-0 sm:p-6 lg:p-8">
      <section class="glass p-6 sm:p-8">
        <h2 class="text-[clamp(2rem,3.4vw,3rem)] leading-[1] font-semibold tracking-[-0.045em]">Tell us what you need.</h2>
        <p class="mt-4 max-w-[52ch] text-[17px] text-muted-foreground">Fill this in and it opens WhatsApp with your message ready to send. Nothing is stored on this site.</p>
        <div class="mt-8">
          <EnquiryForm client:idle whatsapp={business.whatsapp} categories={categories.map((c) => c.name)} />
        </div>
      </section>
    </GlassFrame>
  </div>
</Base>
