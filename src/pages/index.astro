---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import EnquiryForm from "@/components/EnquiryForm";
import SizeRings from "@/components/home/SizeRings";
import AudienceMorph from "@/components/home/AudienceMorph";
import Stats from "@/components/home/Stats";
import BrandSentence from "@/components/home/BrandSentence";
import Globe from "@/components/home/Globe";
import LogoMark from "@/components/LogoMark.astro";
import { buttonVariants } from "@/components/ui/button-variants";
import { business, brands, categories, whatsappUrl } from "@/data/site";
import { brandPages } from "@/data/brands";
import { homeSchema } from "@/lib/schema";
import { ArrowRight01Icon, WhatsappIcon } from "@hugeicons/core-free-icons";

const phone = business.phones[0];
const a = business.address;
const slugFor = (name: string) => brands.find((b) => b.name === name)?.slug;

const brandInfo: Record<string, { from: string; stock: string }> = {
  finolex: { from: "Pune", stock: "Agriculture, casing, column, CPVC, ASTM, SWR and sewerage pipes, solvent cement" },
  dutron: { from: "Ahmedabad", stock: "CPVC, uPVC, agriculture, SWR, casing and HDPE pipes, suction and garden hose" },
  texmo: { from: "Burhanpur, MP", stock: "CPVC to HDPE coils, drip and sprinkler systems, gas pipes, water tanks" },
  waterflo: { from: "Rajkot", stock: "CPVC, uPVC, push-fit SWR, agriculture and borewell pipes, HDPE" },
  johnson: { from: "Baddi and Samba", stock: "Taps, sanitaryware, showers, kitchen sinks, bathtubs, bathroom accessories" },
};
const sentence = brands.map((b) =>
  b.slug
    ? { name: b.name, slug: b.slug, lines: brandPages.find((p) => p.slug === b.slug)!.lines.length, ...brandInfo[b.slug] }
    : { name: b.name },
);
const totalLines = sentence.reduce((n, b) => n + ("lines" in b ? b.lines : 0), 0);

const stats = [
  { value: 1500, suffix: "+", label: "products in stock at the godown" },
  { value: brands.length, label: "brands on our shelves" },
  { value: totalLines, label: "product lines with full specifications online" },
  { value: categories.length, label: "product families, house plumbing to 400 mm mains" },
];

const steps = [
  { title: "Send your list", text: "On WhatsApp. Sizes and quantities are enough, and a photo of a handwritten list is fine." },
  { title: "Get rates the same day", text: "We reply with prices and tell you what's in stock at the godown." },
  { title: "Pick up or we deliver", text: "Collect from the shop in Marhatal, or we send it across Jabalpur and nearby districts." },
];

const wrap = "mx-auto max-w-[88rem] px-5 sm:px-8 lg:px-14";
const label = "text-[17px] sm:text-[13px] text-muted-foreground";
const h2 = "text-[clamp(2.25rem,4.6vw,4.25rem)] leading-[0.98] font-semibold tracking-[-0.045em]";
const link = "sweep inline-flex items-center gap-1.5 font-medium";
---
<Base
  title="Pipes & Sanitary Distributor in Jabalpur, MP | Market Movers"
  description="Market Movers, Jabalpur: distributor of Finolex, Dutron, Texmo, Waterflo & Johnson. PVC, CPVC, HDPE pipes, sprinklers & sanitaryware across Madhya Pradesh."
  path="/"
  jsonLd={homeSchema()}>

  <!-- Logo and name, full width; shrinks into the header logo on scroll (global.css) -->
  <div class="wordmark-top pt-4" aria-hidden="true">
    <div class="flex items-center justify-center gap-[0.14em] px-3 text-[12.4vw] leading-[0.8] font-semibold tracking-[-0.06em] whitespace-nowrap sm:text-[clamp(3rem,13vw,13rem)]">
      <LogoMark id="mm-top" animate class="h-[0.78em] w-auto shrink-0" weight={18} />
      <span>Market Movers</span>
    </div>
  </div>

  <!-- Hero -->
  <!-- The name above is the one giant line; the headline sits a clear step below it
       (smaller, medium weight) so the two don't compete. -->
  <section class:list={[wrap, "grid gap-14 pt-12 pb-24 md:pt-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:items-center lg:gap-20"]}>
    <div class="flex flex-col">
      <p class={label}>Wholesale distributor in Marhatal, Jabalpur</p>
      <h1 class="mt-5 max-w-3xl text-[2.25rem] leading-[1] font-medium tracking-[-0.045em] text-balance sm:text-[clamp(2.75rem,4.8vw,4.5rem)]">
        Pipes, fittings and sanitaryware<span class="text-muted-foreground">, from stock.</span>
      </h1>
      <div class="mt-10 flex flex-col gap-8">
        <div class="max-w-lg">
          <p class="text-[clamp(1.25rem,1.6vw,1.35rem)] leading-snug tracking-[-0.01em]">
            Ten brands in stock at our counter in Marhatal, for <AudienceMorph client:load />. Send your list on
            WhatsApp and we'll reply with rates the same day.
          </p>
          <p lang="hi" class="mt-3 font-hindi text-lg text-muted-foreground">पाइप, फिटिंग और सैनिटरी का सामान, थोक में</p>
        </div>
        <div class="flex shrink-0 items-center gap-6">
          <a href={whatsappUrl("Hello Market Movers, here is my list:")} target="_blank" rel="noopener" class={buttonVariants({ size: "lg" })}>
            <Icon icon={WhatsappIcon} /><span class="roll"><span>WhatsApp your list</span></span>
          </a>
          <a href={`tel:${phone.tel}`} class:list={["sweep hidden items-center gap-1.5 font-medium whitespace-nowrap tabular-nums sm:inline-flex"]}>Call {phone.display}</a>
        </div>
      </div>
    </div>
    <SizeRings client:load />
  </section>

  <!-- Figures -->
  <section class:list={[wrap, "rule-top py-24 md:py-32"]}>
    <h2 class:list={[h2, "max-w-4xl"]} data-reveal>Ready stock, so your site never waits on a factory.</h2>
    <div class="mt-16">
      <Stats client:visible stats={stats} />
    </div>
  </section>

  <!-- Brands -->
  <section id="brands" class:list={[wrap, "rule-top py-24 md:py-32"]}>
    <h2 class="sr-only">Brands we stock</h2>
    <BrandSentence
      client:visible
      brands={sentence}
      askHref={whatsappUrl(`Hello Market Movers, I'd like rates for ${brands.filter((b) => !b.slug).map((b) => b.name).join(" / ")}.`)}
    />
  </section>

  <!-- Products -->
  <section id="products" class:list={[wrap, "rule-top py-24 md:py-32"]}>
    <h2 class={h2} data-reveal>What we stock</h2>
    <p lang="hi" class="mt-3 font-hindi text-lg text-muted-foreground">हमारे पास क्या मिलता है</p>
    <ol class="mt-10 md:mt-14">
      {categories.map((c, i) => (
        <li class="sweep grid gap-x-10 gap-y-3 py-7 md:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] md:items-baseline">
          <h3 class="nudge text-[clamp(1.875rem,3.6vw,3.25rem)] leading-none font-semibold tracking-[-0.045em]">{c.name}</h3>
          <div class="text-[19px] sm:text-[15px] leading-relaxed">
            <p class="text-muted-foreground">{c.text}</p>
            <p class="mt-2">
              {c.brands.length === 0 ? (
                "All brands"
              ) : (
                c.brands.map((name, j) => {
                  const slug = slugFor(name);
                  return (
                    <>
                      {j > 0 && ", "}
                      {slug ? <a href={`/${slug}.html`} class="text-teal underline decoration-teal/30 underline-offset-4 hover:decoration-teal">{name}</a> : name}
                    </>
                  );
                })
              )}
            </p>
          </div>
        </li>
      ))}
    </ol>
    <p class="mt-10 text-lg">
      Something else? <a href={whatsappUrl("Hello Market Movers, do you have ")} target="_blank" rel="noopener" class:list={[link, "text-teal"]}>Ask us on WhatsApp</a>
    </p>
  </section>

  <!-- Ordering -->
  <section id="order" class="bg-card">
    <div class:list={[wrap, "py-24 md:py-40"]}>
      <h2 class:list={[h2, "read-words max-w-4xl"]}>
        {"Send the list. We'll handle the rest.".split(" ").map((w) => <span>{w} </span>)}
      </h2>
      <p lang="hi" class="mt-3 font-hindi text-lg text-muted-foreground">ऑर्डर कैसे करें</p>
      <ol class="mt-14 border-b border-border">
        {steps.map((st, i) => (
          <li class="grid gap-x-10 gap-y-2 border-t border-border py-8 md:grid-cols-[3rem_minmax(0,1.15fr)_minmax(0,1fr)] md:items-baseline" data-reveal>
            <span class="text-[17px] sm:text-[13px] text-muted-foreground tabular-nums">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="text-[clamp(1.625rem,2.6vw,2.25rem)] leading-tight font-semibold tracking-[-0.04em] text-balance">{st.title}</h3>
            <p class="text-[19px] sm:text-[15px] leading-relaxed text-muted-foreground">{st.text}</p>
          </li>
        ))}
      </ol>
      <a href={whatsappUrl("Hello Market Movers, here is my list:")} target="_blank" rel="noopener" class={buttonVariants({ size: "lg", class: "mt-14" })}>
        <Icon icon={WhatsappIcon} /><span class="roll"><span>Send your list</span></span>
      </a>
    </div>
  </section>

  <!-- Visit -->
  <section id="contact" class:list={[wrap, "grid items-center gap-14 py-24 md:py-32 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]"]}>
    <div>
      <h2 class="text-[clamp(2.75rem,6.4vw,6rem)] leading-[0.92] font-semibold tracking-[-0.055em]" data-reveal>
        {a.street}, {a.city}.
      </h2>
      <p lang="hi" class="mt-3 font-hindi text-lg text-muted-foreground">दुकान पर आइए</p>
      <div class="mt-10 space-y-2 text-lg">
        <p>{business.hours.days}, {business.hours.display}. <span class="text-muted-foreground">Sunday closed.</span></p>
        <p class="tabular-nums">
          {business.phones.map((p, i) => (
            <>{i > 0 && <span class="text-muted-foreground"> · </span>}<a href={`tel:${p.tel}`} class="hover:text-teal">{p.display}</a></>
          ))}
        </p>
      </div>
      <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
        <a href={business.mapUrl} target="_blank" rel="noopener" class:list={[link, "text-teal"]}>Open in Google Maps<Icon icon={ArrowRight01Icon} size={16} class="sweep-arrow" /></a>
        <a href={whatsappUrl()} target="_blank" rel="noopener" class:list={[link, "text-teal"]}>WhatsApp {phone.display}<Icon icon={ArrowRight01Icon} size={16} class="sweep-arrow" /></a>
      </div>
    </div>
    <div class="mx-auto w-full max-w-[520px]">
      <Globe client:visible />
      <p class="mt-2 text-center text-[17px] sm:text-[13px] text-muted-foreground">Jabalpur and nearby districts. Drag to spin.</p>
    </div>
  </section>

  <!-- Enquiry -->
  <section class:list={[wrap, "rule-top grid gap-12 py-24 md:py-32 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-20"]}>
    <div>
      <h2 class={h2} data-reveal>Tell us what you need.</h2>
      <p class="mt-5 max-w-md text-lg text-muted-foreground">Fill this in and it opens WhatsApp with your message ready to send. Nothing is stored on this site.</p>
    </div>
    <EnquiryForm client:idle whatsapp={business.whatsapp} categories={categories.map((c) => c.name)} />
  </section>
</Base>
