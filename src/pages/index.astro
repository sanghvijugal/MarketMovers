---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import EnquiryForm from "@/components/EnquiryForm";
import { buttonVariants } from "@/components/ui/button-variants";
import { business, brands, categories, customers, whatsappUrl } from "@/data/site";
import { brandPages } from "@/data/brands";
import { homeSchema } from "@/lib/schema";
import { ArrowRight01Icon, Call02Icon, WhatsappIcon } from "@hugeicons/core-free-icons";

const phone = business.phones[0];
const a = business.address;
const slugFor = (name: string) => brands.find((b) => b.name === name)?.slug;
const others = brands.filter((b) => !b.slug);

// One line per brand for the rate-list style table.
const brandRows: Record<string, { from: string; stock: string }> = {
  finolex: { from: "Pune", stock: "Agriculture, casing, column, CPVC, ASTM, SWR and sewerage pipes, solvent cement" },
  dutron: { from: "Ahmedabad", stock: "CPVC, uPVC, agriculture, SWR, casing and HDPE pipes, suction and garden hose" },
  texmo: { from: "Burhanpur, MP", stock: "CPVC to HDPE coils, drip and sprinkler systems, gas pipes, water tanks" },
  waterflo: { from: "Rajkot", stock: "CPVC, uPVC, push-fit SWR, agriculture and borewell pipes, HDPE" },
  johnson: { from: "Baddi & Samba", stock: "Taps, sanitaryware, showers, kitchen sinks, bathtubs, bathroom accessories" },
};
const featured = brands
  .filter((b) => b.slug)
  .map((b) => ({ ...b, lines: brandPages.find((p) => p.slug === b.slug)!.lines.length, row: brandRows[b.slug!] }));

const facts = [
  { k: "In stock", v: "1,500+ products" },
  { k: "Supply", v: "Same or next day, Jabalpur and nearby districts" },
  { k: "Open", v: `${business.hours.days}, ${business.hours.display}` },
  { k: "Registered", v: "MSME supplier for government and institutional projects" },
];

const steps = [
  "Send your list on WhatsApp. Sizes and quantities are enough; a photo of a handwritten list is fine.",
  "We reply with rates and what's in stock, usually the same day.",
  "Pick it up from the shop, or we send it across Jabalpur and nearby districts.",
];

const joinList = (xs: readonly string[]) => (xs.length < 2 ? xs.join("") : `${xs.slice(0, -1).join(", ")} and ${xs[xs.length - 1]}`);

const wrap = "mx-auto max-w-7xl px-4 sm:px-6 lg:px-8";
const sectionHead = "flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b-2 border-rule pb-3";
const h2 = "font-display text-[clamp(2rem,4vw,3rem)] leading-none font-bold uppercase";
const hi = "text-lg font-semibold text-muted-foreground";
---
<Base
  title="Pipes & Sanitary Distributor in Jabalpur, MP | Market Movers"
  description="Market Movers, Jabalpur: distributor of Finolex, Dutron, Texmo, Waterflo & Johnson. PVC, CPVC, HDPE pipes, sprinklers & sanitaryware across Madhya Pradesh."
  path="/"
  jsonLd={homeSchema()}>

  <!-- Signboard: framed like a painted shop sign -->
  <section class="bg-inverse px-3 py-3 text-inverse-foreground sm:px-5 sm:py-5">
    <div class="mx-auto max-w-[90rem] border-2 border-white/40">
      <div class:list={[wrap, "py-10 md:py-14"]}>
        <p class="text-[15px] font-medium text-inverse-muted">Wholesale distributor · {a.street}, {a.city}</p>
        <h1 class="mt-3 font-display text-[clamp(3rem,9vw,7.5rem)] leading-[0.92] font-bold uppercase">
          Pipes, fittings &amp; sanitaryware
        </h1>
        <p lang="hi" class="mt-4 text-[clamp(1.25rem,2.4vw,1.75rem)] font-semibold">पाइप, फिटिंग और सैनिटरी का सामान, थोक में</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href={`tel:${phone.tel}`} class={buttonVariants({ size: "lg", class: "bg-white text-primary hover:bg-white/90" })}>
            <Icon icon={Call02Icon} /><span class="tabular-nums">Call {phone.display}</span>
          </a>
          <a href={whatsappUrl("Hello Market Movers, here is my list:")} target="_blank" rel="noopener" class={buttonVariants({ size: "lg", variant: "outline", class: "border-white bg-transparent text-white hover:bg-white/10" })}>
            <Icon icon={WhatsappIcon} />WhatsApp your list
          </a>
        </div>
      </div>
      <ul aria-label="Brands we stock" class="flex flex-wrap justify-between gap-x-6 gap-y-1 border-t-2 border-white/40 px-4 py-3 font-display text-[clamp(1.125rem,2vw,1.625rem)] font-semibold tracking-[0.04em] text-inverse-muted uppercase sm:px-6 lg:px-8">
        {brands.map((b) => <li>{b.name.replace(" Bathrooms", "")}</li>)}
      </ul>
    </div>
  </section>

  <!-- Intro and facts -->
  <section class:list={[wrap, "grid gap-10 py-14 md:grid-cols-[1.2fr_1fr] md:gap-16 md:py-20"]}>
    <div>
      <p class="text-[clamp(1.375rem,2.4vw,1.875rem)] leading-snug font-medium">
        We keep pipes, fittings and bathroom products from {brands.length} brands in stock at our shop in Marhatal. Tell us what
        you need and we'll give you the rate and tell you what's on the shelf.
      </p>
      <p class="mt-5 text-lg text-muted-foreground">
        We supply {joinList(customers.map((c) => c.toLowerCase()))} across Jabalpur and Madhya Pradesh.
      </p>
    </div>
    <dl class="self-start border-t-2 border-rule">
      {facts.map((f) => (
        <div class="grid grid-cols-[7.5rem_1fr] gap-4 border-b border-border py-3.5">
          <dt class="text-sm font-semibold tracking-wide text-muted-foreground uppercase">{f.k}</dt>
          <dd class="font-medium tabular-nums">{f.v}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Brands -->
  <section id="brands" class:list={[wrap, "pb-16 md:pb-24"]}>
    <div class={sectionHead}>
      <h2 class={h2}>Brands we stock</h2>
      <p lang="hi" class={hi}>हमारे ब्रांड</p>
    </div>
    <table class="w-full text-left">
      <caption class="sr-only">Brands we stock, what we carry from each, and links to their catalogues</caption>
      <thead class="text-sm font-semibold tracking-wide text-muted-foreground uppercase">
        <tr class="border-b border-border">
          <th scope="col" class="py-3 pr-4 font-semibold">Brand</th>
          <th scope="col" class="hidden py-3 pr-4 font-semibold lg:table-cell">From</th>
          <th scope="col" class="hidden py-3 pr-4 font-semibold sm:table-cell">What we stock</th>
          <th scope="col" class="py-3 text-right font-semibold"><span class="sr-only">Catalogue</span></th>
        </tr>
      </thead>
      <tbody>
        {featured.map((b) => (
          <tr class="border-b border-border align-top">
            <th scope="row" class="py-4 pr-4 font-normal">
              <a href={`/${b.slug}.html`} class="font-display text-[28px] leading-none font-bold uppercase hover:text-primary">{b.name}</a>
              <span class="mt-1.5 block text-[15px] text-muted-foreground sm:hidden">{b.row.stock}</span>
            </th>
            <td class="hidden py-4 pr-4 pt-5 text-muted-foreground lg:table-cell">{b.row.from}</td>
            <td class="hidden py-4 pr-4 pt-5 sm:table-cell">{b.row.stock}</td>
            <td class="py-4 pt-5 text-right whitespace-nowrap">
              <a href={`/${b.slug}.html`} class="inline-flex items-center gap-1 font-semibold text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">
                See {b.lines} lines<Icon icon={ArrowRight01Icon} size={16} />
              </a>
            </td>
          </tr>
        ))}
        <tr class="border-b border-border align-top">
          <th scope="row" class="py-4 pr-4 font-normal">
            <span class="font-display text-[28px] leading-none font-bold uppercase">{others.map((b) => b.name).join(", ")}</span>
            <span class="mt-1.5 block text-[15px] text-muted-foreground sm:hidden">No catalogue online yet. Ask us for sizes and rates.</span>
          </th>
          <td class="hidden py-4 pr-4 lg:table-cell"></td>
          <td class="hidden py-4 pr-4 pt-5 sm:table-cell">No catalogue online yet. Ask us for sizes and rates.</td>
          <td class="py-4 pt-5 text-right whitespace-nowrap">
            <a href={whatsappUrl(`Hello Market Movers, I'd like rates for ${others.map((b) => b.name).join(" / ")}.`)} target="_blank" rel="noopener" class="inline-flex items-center gap-1 font-semibold text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">
              Ask<Icon icon={ArrowRight01Icon} size={16} />
            </a>
          </td>
        </tr>
      </tbody>
    </table>
  </section>

  <!-- What we stock -->
  <section id="products" class="border-y border-border bg-card">
    <div class:list={[wrap, "py-16 md:py-24"]}>
      <div class={sectionHead}>
        <h2 class={h2}>What we stock</h2>
        <p lang="hi" class={hi}>हमारे पास क्या मिलता है</p>
      </div>
      <ul class="grid md:grid-cols-2 md:gap-x-16">
        {categories.map((c) => (
          <li class="border-b border-border py-6">
            <h3 class="font-display text-[26px] leading-tight font-bold uppercase">{c.name}</h3>
            <p class="mt-1.5 text-muted-foreground">{c.text}</p>
            <p class="mt-2.5 text-[15px]">
              {c.brands.length === 0 ? (
                <span class="font-medium">All brands</span>
              ) : (
                c.brands.map((name, i) => {
                  const slug = slugFor(name);
                  return (
                    <>
                      {i > 0 && ", "}
                      {slug ? <a href={`/${slug}.html`} class="font-medium text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">{name}</a> : <span class="font-medium">{name}</span>}
                    </>
                  );
                })
              )}
            </p>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-lg">
        Don't see what you need? <a href={whatsappUrl("Hello Market Movers, do you have ")} target="_blank" rel="noopener" class="font-semibold text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">Ask us on WhatsApp</a>.
      </p>
    </div>
  </section>

  <!-- How to order -->
  <section id="order" class:list={[wrap, "py-16 md:py-24"]}>
    <div class={sectionHead}>
      <h2 class={h2}>How to order</h2>
      <p lang="hi" class={hi}>ऑर्डर कैसे करें</p>
    </div>
    <ol class="grid md:grid-cols-3 md:gap-x-12">
      {steps.map((s, i) => (
        <li class="flex gap-4 border-b border-border py-6 md:border-b-0">
          <span class="font-display text-5xl leading-[0.8] font-bold text-primary tabular-nums" aria-hidden="true">{i + 1}</span>
          <p class="text-lg">{s}</p>
        </li>
      ))}
    </ol>
    <a href={whatsappUrl("Hello Market Movers, here is my list:")} target="_blank" rel="noopener" class={buttonVariants({ size: "lg", class: "mt-6" })}>
      <Icon icon={WhatsappIcon} />Send your list on WhatsApp
    </a>
  </section>

  <!-- Shop and contact -->
  <section id="contact" class="border-t border-border bg-muted">
    <div class:list={[wrap, "grid gap-12 py-16 md:py-24 lg:grid-cols-[1fr_1.1fr] lg:gap-16"]}>
      <div>
        <div class={sectionHead}>
          <h2 class={h2}>Visit the shop</h2>
          <p lang="hi" class={hi}>दुकान पर आइए</p>
        </div>
        <address class="mt-6 text-[clamp(1.375rem,2.4vw,1.75rem)] leading-snug font-medium not-italic">
          {a.street}<br />{a.city}, {a.region} {a.postalCode}
        </address>
        <a href={business.mapUrl} target="_blank" rel="noopener" class={buttonVariants({ variant: "outline", class: "mt-5" })}>Open in Google Maps</a>
        <dl class="mt-10 border-t-2 border-rule">
          <div class="grid grid-cols-[7.5rem_1fr] gap-4 border-b border-border py-3.5">
            <dt class="text-sm font-semibold tracking-wide text-muted-foreground uppercase">Hours</dt>
            <dd class="font-medium">{business.hours.days}, {business.hours.display}<br /><span class="text-muted-foreground">Sunday closed</span></dd>
          </div>
          <div class="grid grid-cols-[7.5rem_1fr] gap-4 border-b border-border py-3.5">
            <dt class="text-sm font-semibold tracking-wide text-muted-foreground uppercase">Phone</dt>
            <dd class="font-medium tabular-nums">
              {business.phones.map((p) => <a href={`tel:${p.tel}`} class="block hover:text-primary">{p.display}</a>)}
            </dd>
          </div>
          <div class="grid grid-cols-[7.5rem_1fr] gap-4 border-b border-border py-3.5">
            <dt class="text-sm font-semibold tracking-wide text-muted-foreground uppercase">WhatsApp</dt>
            <dd class="font-medium tabular-nums"><a href={whatsappUrl()} target="_blank" rel="noopener" class="hover:text-primary">{phone.display}</a></dd>
          </div>
        </dl>
      </div>
      <div class="self-start border-2 border-rule bg-card p-6 sm:p-8">
        <h3 class="font-display text-[28px] leading-none font-bold uppercase">Send an enquiry</h3>
        <p class="mt-2 text-muted-foreground">Fill this in and it opens WhatsApp with your message ready to send.</p>
        <div class="mt-6">
          <EnquiryForm client:idle whatsapp={business.whatsapp} categories={categories.map((c) => c.name)} />
        </div>
      </div>
    </div>
  </section>
</Base>
