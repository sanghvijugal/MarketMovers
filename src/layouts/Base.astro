---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE_URL } from "@/data/site";

interface Props {
  title: string;
  description: string;
  /** Path of this page, e.g. "/" or "/dutron.html". Omit for noindex pages. */
  path?: string;
  jsonLd?: object;
  noindex?: boolean;
}
const { title, description, path, jsonLd, noindex = false } = Astro.props;
const url = path ? SITE_URL + path : undefined;
const ogImage = `${SITE_URL}/assets/og-image.jpg`;
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    {url && <link rel="canonical" href={url} />}
    <link rel="icon" href="/assets/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <meta name="theme-color" content="#fcfbf9" />
    {url && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Market Movers" />
        <meta property="og:locale" content="en_IN" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={url} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Market Movers – pipes, fittings and sanitary distributor in Jabalpur" />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-card focus:px-3 focus:py-2 focus:shadow">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
