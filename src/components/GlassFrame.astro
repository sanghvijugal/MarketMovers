---
// A photo with content floating over it on glass panels ("baked glass").
// Instead of a live backdrop-filter (slow on phones, drains battery), each
// `.glass` panel inside paints a pre-blurred copy of the same photo, lined up
// with the sharp photo underneath by the script below. Both the photo and the
// blurred copies drift a little slower than the page as it scrolls (a
// scroll-driven CSS transform, see global.css), so the panels move over the
// photo. Without JavaScript the panels fall back to a plain frosted fill.
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  blur: ImageMetadata;
  alt: string;
  /** object-position as "x% y%", shared by the photo and the blurred copy */
  pos?: string;
  sizes?: string;
  loading?: "lazy" | "eager";
  class?: string;
  id?: string;
}
const { src, blur, alt, pos = "50% 50%", sizes = "100vw", loading = "lazy", class: cls, id } = Astro.props;
---
<div
  id={id}
  class:list={["glass-frame relative isolate overflow-hidden", cls]}
  data-glass
  style={`--glass-photo: url("${blur.src}"); --glass-pos: ${pos}`}>
  <div class="glass-photo absolute inset-x-0 -z-10">
  <Picture
    src={src}
    formats={["avif", "webp"]}
    quality={72}
    widths={[640, 1024, 1600, 2000]}
    sizes={sizes}
    alt={alt}
    loading={loading}
    fetchpriority={loading === "eager" ? "high" : undefined}
    class="h-full w-full object-cover"
    style={`object-position: ${pos}`}
  />
  </div>
  <slot />
</div>

<script>
  // Give each panel its offset inside the frame, so its blurred copy (a
  // ::before the size of the photo layer) sits exactly over the photo.
  // Runs on layout changes only (ResizeObserver), never on scroll.
  function bake(frame: HTMLElement) {
    const f = frame.getBoundingClientRect();
    frame.querySelectorAll<HTMLElement>(".glass").forEach((p) => {
      const r = p.getBoundingClientRect();
      p.style.setProperty("--gx", `${r.left - f.left + p.clientLeft}px`);
      p.style.setProperty("--gy", `${r.top - f.top + p.clientTop}px`);
      p.style.setProperty("--fw", `${f.width}px`);
      p.style.setProperty("--fh", `${f.height}px`);
      p.dataset.baked = "";
    });
  }
  const frames = document.querySelectorAll<HTMLElement>("[data-glass]");
  const ro = new ResizeObserver((entries) => {
    const seen = new Set<HTMLElement>();
    for (const e of entries) {
      const frame = (e.target as HTMLElement).closest<HTMLElement>("[data-glass]");
      if (frame && !seen.has(frame)) { seen.add(frame); bake(frame); }
    }
  });
  frames.forEach((frame) => {
    ro.observe(frame);
    frame.querySelectorAll(".glass").forEach((p) => ro.observe(p));
  });
  document.fonts?.ready.then(() => frames.forEach(bake));
</script>
