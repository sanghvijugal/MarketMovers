---
import Logo from "./Logo.astro";
import { business, brands, whatsappUrl } from "@/data/site";
const year = new Date().getFullYear();
const a = business.address;
const link = "transition-colors duration-150 hover:text-brass";
---
<footer class="border-t border-brass-soft bg-inverse text-inverse-foreground">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr] lg:px-8">
    <div class="space-y-4">
      <Logo />
      <p class="max-w-xs text-sm text-inverse-muted">
        Wholesale distributor of pipes, fittings and sanitaryware in Jabalpur, Madhya Pradesh.
      </p>
    </div>
    <div>
      <h2 class="text-xs font-semibold tracking-[0.14em] text-brass uppercase">Brand catalogues</h2>
      <ul class="mt-4 space-y-2 text-sm text-inverse-muted">
        {brands.filter((b) => b.slug).map((b) => (
          <li><a href={`/${b.slug}.html`} class={link}>{b.name}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="text-xs font-semibold tracking-[0.14em] text-brass uppercase">Visit or call</h2>
      <address class="mt-4 space-y-2 text-sm text-inverse-muted not-italic">
        <p>{a.street}<br />{a.city}, {a.region} {a.postalCode}</p>
        <p class="flex flex-col items-start">
          {business.phones.map((p) => (
            <a href={`tel:${p.tel}`} class={`py-1 tabular-nums ${link}`}>{p.display}</a>
          ))}
        </p>
        <p><a href={whatsappUrl()} target="_blank" rel="noopener" class={link}>WhatsApp</a> · <a href={business.mapUrl} target="_blank" rel="noopener" class={link}>Google Maps</a></p>
        <p>{business.hours.short}, {business.hours.display}</p>
      </address>
    </div>
  </div>
  <div class="border-t border-brass-soft">
    <p class="mx-auto max-w-7xl px-4 py-5 text-xs text-inverse-muted sm:px-6 lg:px-8">© {year} Market Movers, Jabalpur</p>
  </div>
</footer>
