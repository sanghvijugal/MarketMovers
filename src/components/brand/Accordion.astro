---
// Disclosure built on the transitions.dev "Accordion expand" recipe.
// Collapsed panels use hidden="until-found": content stays in the HTML
// (Google reads it) and browser find-in-page can still reveal it.
interface Props {
  id: string;
  title: string;
  subtitle?: string;
  level?: 3 | 4;
}
const { id, title, subtitle, level = 3 } = Astro.props;
const H = `h${level}` as "h3" | "h4";
---
<div class="t-acc border-b" data-open="false">
  <H class="m-0">
    <button
      type="button"
      id={`${id}-btn`}
      class="t-acc-head flex w-full cursor-pointer items-center justify-between gap-4 py-4 text-left"
      aria-expanded="false"
      aria-controls={`${id}-panel`}>
      <span class="min-w-0">
        <span class="block font-medium">{title}</span>
        {subtitle && <span class="mt-0.5 block text-sm font-normal text-muted-foreground">{subtitle}</span>}
      </span>
      <span class="t-acc-chevron shrink-0 text-muted-foreground" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6.5L8 10.5L12 6.5" /></svg>
      </span>
    </button>
  </H>
  <div class="t-acc-panel" id={`${id}-panel`}>
    <div class="t-acc-panel-inner" hidden="until-found">
      <div class="pb-6"><slot /></div>
    </div>
  </div>
</div>
