---
// PLACEHOLDER LOGO — replace this component's markup with the real Market
// Movers logo (drop the SVG/PNG into public/assets/ and render it here).
interface Props { class?: string; inverse?: boolean }
const { class: className, inverse = false } = Astro.props;
---
<span class:list={["inline-flex items-center gap-2.5", className]}>
  <span
    class:list={[
      "grid size-9 place-items-center rounded-[10px] text-[13px] font-semibold",
      inverse ? "bg-inverse-foreground text-inverse" : "bg-foreground text-background",
    ]}
    aria-hidden="true">MM</span>
  <span class="text-[17px] font-semibold">Market Movers</span>
</span>
