---
import MorphIcon from "morphicons/astro";
import { Menu01Icon, Call02Icon, WhatsappIcon } from "@hugeicons/core-free-icons";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { buttonVariants } from "./ui/button-variants";
import { business, whatsappUrl } from "@/data/site";

const nav = [
  { href: "/#brands", label: "Brands" },
  { href: "/#products", label: "Products" },
  { href: "/#order", label: "How to order" },
  { href: "/#contact", label: "Visit" },
];
const phone = business.phones[0];
const wa = whatsappUrl("Hello Market Movers, I have an enquiry.");
---
<header class="sticky top-0 z-40 px-2.5 pt-2.5 sm:px-4 lg:px-8" style="view-transition-name: site-header">
  <div class="glass-live relative mx-auto flex h-[60px] max-w-[86rem] items-center justify-between gap-6 rounded-full pr-2 pl-5 sm:pr-2.5 sm:pl-6 lg:h-[64px] lg:pl-8">
    <a href="/" aria-label="Market Movers home">
      <Logo class="header-logo" />
    </a>

    <!-- Phones, homepage only: at the top of the page the bar shows the menu
         links; as the big name shrinks into the logo they slide away into the
         menu button (global.css). Hidden everywhere else. -->
    <nav aria-label="Main (top of page)" class="header-links absolute inset-y-0 right-5 left-5 items-center md:hidden">
      <ul class="flex w-full items-center justify-between text-[clamp(13px,3.9vw,15px)] font-medium">
        {nav.map((l) => (
          <li><a href={l.href} class="block py-2 whitespace-nowrap">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-8 text-[18px] sm:text-[14px] text-muted-foreground">
        {nav.map((l) => (
          <li>
            <a href={l.href} class="sweep pb-0.5 transition-colors duration-150 hover:text-foreground">{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-5">
      <p class="hidden items-center gap-2 text-[17px] sm:text-[13px] text-muted-foreground xl:flex">
        <span class="size-1.5 rounded-full bg-teal" data-open-dot aria-hidden="true"></span>
        <span data-open-status data-opens={parseInt(business.hours.opens)} data-closes={parseInt(business.hours.closes)}>{business.hours.short}, {business.hours.display}</span>
      </p>
      <a href={wa} target="_blank" rel="noopener" class={buttonVariants({ class: "hidden sm:inline-flex" })}>
        <span class="roll"><span>WhatsApp</span></span>
      </a>
      <button
        type="button"
        id="menu-button"
        class={buttonVariants({ variant: "ghost", size: "icon", class: "md:hidden" })}
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu">
        <MorphIcon icon={Menu01Icon} id="menu-icon" size={24} strokeWidth={1.5} reducedMotion="user" />
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="t-dropdown absolute inset-x-3 top-[calc(100%+0.25rem)] z-50 rounded-2xl border border-border bg-card p-2 shadow-[0_24px_60px_-20px_rgb(0_0_0/0.25)] md:hidden">
    <nav aria-label="Main (mobile)">
      <ul>
        {nav.map((l) => (
          <li>
            <a href={l.href} class="flex h-14 items-center rounded-xl px-3 text-[28px] font-semibold tracking-[-0.03em] hover:bg-muted">{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="mt-2 grid grid-cols-2 gap-2 border-t border-border p-2 pt-4">
      <a href={`tel:${phone.tel}`} class={buttonVariants({ variant: "outline", size: "lg" })}>
        <Icon icon={Call02Icon} />Call
      </a>
      <a href={wa} target="_blank" rel="noopener" class={buttonVariants({ size: "lg" })}>
        <Icon icon={WhatsappIcon} />WhatsApp
      </a>
    </div>
  </div>
</header>

<script>
  import { Menu01Icon, Cancel01Icon } from "@hugeicons/core-free-icons";
  import type { MorphIconElement } from "morphicons/element";

  const button = document.getElementById("menu-button")!;
  const menu = document.getElementById("mobile-menu")!;
  const icon = document.querySelector<MorphIconElement>("#menu-icon");
  const closeMs =
    parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--dropdown-close-dur")) || 150;
  let closeTimer: number | undefined;

  // Keyboard-initiated closes are instant: animating them only makes the UI feel slow.
  function setOpen(open: boolean, instant = false) {
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    icon?.morphTo(open ? Cancel01Icon : Menu01Icon);
    clearTimeout(closeTimer);
    if (open) {
      menu.classList.remove("is-closing");
      menu.classList.add("is-open");
    } else if (instant) {
      menu.classList.remove("is-open", "is-closing");
    } else if (menu.classList.contains("is-open")) {
      menu.classList.remove("is-open");
      menu.classList.add("is-closing");
      closeTimer = window.setTimeout(() => menu.classList.remove("is-closing"), closeMs);
    }
  }
  const isOpen = () => button.getAttribute("aria-expanded") === "true";

  button.addEventListener("click", () => setOpen(!isOpen()));
  menu.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen()) {
      setOpen(false, true);
      button.focus();
    }
  });
  document.addEventListener("click", (e) => {
    if (isOpen() && !menu.contains(e.target as Node) && !button.contains(e.target as Node)) setOpen(false);
  });
  matchMedia("(min-width: 768px)").addEventListener("change", (e) => e.matches && setOpen(false));

  // "Open now" status, worked out in Jabalpur time (IST, UTC+5:30), Monday to
  // Saturday. Hours come from site.ts. Falls back to the static text if this doesn't run.
  const status = document.querySelector<HTMLElement>("[data-open-status]");
  const dot = document.querySelector<HTMLElement>("[data-open-dot]");
  if (status) {
    const opens = Number(status.dataset.opens), closes = Number(status.dataset.closes);
    const fmt = (h: number) => (h > 12 ? `${h - 12} pm` : h === 12 ? "12 pm" : `${h} am`);
    const ist = new Date(Date.now() + (5.5 * 60 + new Date().getTimezoneOffset()) * 60_000);
    const day = ist.getDay();
    const h = ist.getHours() + ist.getMinutes() / 60;
    const workday = day >= 1 && day <= 6;
    if (workday && h >= opens && h < closes) status.textContent = `Open now, till ${fmt(closes)}`;
    else {
      const opensToday = workday && h < opens;
      const nextDay = opensToday ? "" : day === 6 || day === 0 ? " Monday" : " tomorrow";
      status.textContent = `Closed now, opens ${fmt(opens)}${nextDay}`;
      dot?.classList.replace("bg-teal", "bg-faint");
    }
  }
</script>
