---
// The Market Movers mark: two Ms, one inside the other, drawn as a single loop
// that weaves over and under itself. The inner M takes `inner`, the outer M `outer`.
// Geometry is fixed; only the stroke weight changes (heavier for small sizes).
interface Props {
  id: string; // unique per page, used for the crossing mask
  class?: string;
  inner?: string;
  outer?: string;
  weight?: number;
  title?: string;
}
const { id, class: className, inner = "currentColor", outer = "var(--teal)", weight = 14, title } = Astro.props;

const a = 64, b = 112, s = 0.625, t2 = 24, B = 200, sw = weight, gap = Math.round(weight * 0.5);
const v1 = a * s, v2 = t2 + b * s, yc = t2 + (b - a) * s;
const P = (pts: number[][]) => "M" + pts.map((p) => p.join(",")).join("L");
const innerPath = P([[-a, B], [-a, 0], [0, v1], [a, 0], [a, B]]);
const outerPath = P([[a, B], [b, B], [b, t2], [0, v2], [-b, t2], [-b, B], [-a, B]]);
// Crossings: the inner left leg passes over the outer diagonal; the outer right
// diagonal passes over the inner right leg. Cut a gap, then redraw the strand on top.
const len = Math.hypot(1, s), ux = -1 / len, uy = s / len;
const r = (k: number) => +k.toFixed(2);
const seg = (L: number) => ({
  left: `M${-a},${r(yc - L)}L${-a},${r(yc + L)}`,
  right: `M${r(a - ux * L)},${r(yc - uy * L)}L${r(a + ux * L)},${r(yc + uy * L)}`,
});
const cut = seg(sw * 2), redraw = seg(sw * 3.6);
const pad = sw;
const viewBox = `${-b - pad} ${-pad * 2} ${2 * (b + pad)} ${B + pad * 3}`;
const stroke = { fill: "none", "stroke-width": sw, "stroke-linejoin": "miter", "stroke-miterlimit": "4" } as const;
---
<svg viewBox={viewBox} class={className} role={title ? "img" : undefined} aria-label={title} aria-hidden={title ? undefined : "true"} xmlns="http://www.w3.org/2000/svg">
  <mask id={id} maskUnits="userSpaceOnUse" x="-400" y="-400" width="800" height="800">
    <rect x="-400" y="-400" width="800" height="800" fill="#fff" />
    <path d={cut.left + cut.right} stroke="#000" stroke-width={sw + 2 * gap} />
  </mask>
  <g mask={`url(#${id})`}>
    <path d={outerPath} stroke={outer} {...stroke} />
    <path d={innerPath} stroke={inner} stroke-linecap="square" {...stroke} />
  </g>
  <path d={redraw.left} stroke={inner} {...stroke} />
  <path d={redraw.right} stroke={outer} {...stroke} />
</svg>
